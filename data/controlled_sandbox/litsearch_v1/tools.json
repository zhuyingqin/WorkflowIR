          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "relevance": {
              "type": "number"
            },
            "recency": {
              "type": "number"
            },
            "evidence": {
              "type": "number"
            },
            "diversity": {
              "type": "number"
            }
          }
        }
      }
    },
    "output_schema": {
      "type": "object",
      "required": [
        "ranked_ids",
        "score_breakdown"
      ],
      "properties": {
        "ranked_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "score_breakdown": {
          "type": "object"
        }
      }
    },
